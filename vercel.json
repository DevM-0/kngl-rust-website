{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/streamers",
      "dest": "/api/streamers.js",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/style.css(.*)",
      "dest": "/style.css"
    },
    {
      "src": "/script.js(.*)",
      "dest": "/script.js"
    },
    {
      "src": "/logo.jpg",
      "dest": "/logo.jpg"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
